{
  "name": "stream-unirradio",
  "productName": "Stream Radio",
  "version": "1.3.1",
  "description": "Aplicación de escritorio para transmitir radio en vivo hacia Zeno.fm y Centova Cast mediante Icecast o SHOUTcast",
  "main": "src/main/main.js",
  "author": "UNIR Radio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:publish": "electron-builder --publish always",
    "postinstall": "electron-rebuild -f -w naudiodon"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.unirradio.streamunirradio",
    "productName": "Stream Radio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "artifactName": "Stream-Radio-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "resources/ffmpeg/",
        "to": "ffmpeg/"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stream Radio",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jhersara",
        "repo": "Stream-Unirradio"
      }
    ]
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "naudiodon": "^2.3.6"
  }
}
